{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"FailureRecoveryPackage","type":"object","additionalProperties":true,
  "required":["mission_id","run_id","layer","source_attempt_id","failure_class","terminal_status","r1_refs"],
  "properties":{
    "mission_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},
    "layer":{"type":"string","enum":["L1","L2","L3","L4","L5","L6","L7"]},
    "source_attempt_id":{"type":"string","minLength":1},"final_attempt_id":{"type":"string"},
    "failure_class":{"type":"string"},"ownership_matrix":{"type":"object"},"repair_work_order_refs":{"type":"array"},
    "repair_receipt_refs":{"type":"array"},"successor_attempt_refs":{"type":"array"},
    "terminal_status":{"type":"string"},"r1_refs":{"type":"array","minItems":1}
  }
}
