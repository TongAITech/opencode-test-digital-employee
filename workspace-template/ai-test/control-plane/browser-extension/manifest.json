{
  "manifest_version": 3,
  "name": "AI Test Controlled Browser Recorder",
  "version": "1.11.0",
  "description": "Records sanitized human teaching and takeover events for the local AI Test Runtime.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}],
  "action": {"default_title": "AI Test Teach Mode"}
}
